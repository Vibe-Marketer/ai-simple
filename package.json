{
  "name": "aisimple-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --watch",
    "build": "npm run build:css",
    "dev": "npm run watch:css",
    "optimize-images": "node scripts/optimize-images.js",
    "enrich": "node scripts/enrich-contacts.js enrich",
    "listen": "node scripts/enrich-contacts.js listen",
    "setup-fub": "node scripts/enrich-contacts.js setup-fields"
  },
  "devDependencies": {
    "sharp": "^0.33.2",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cheerio": "^1.2.0",
    "composio-core": "^0.5.39",
    "disposable-email-domains": "^1.0.62",
    "libphonenumber-js": "^1.12.40",
    "openai": "^6.33.0",
    "stripe": "^20.4.0"
  }
}
