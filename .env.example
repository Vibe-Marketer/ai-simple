# ═══════════════════════════════════════════════════════════
# FUB Contact Enrichment Pipeline — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ─── Required ─────────────────────────────────────────────

# Follow Up Boss API Key
# Get yours at: Settings → API → Generate API Key
FUB_API_KEY=your_fub_api_key_here

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── Optional: Supabase (for persistent storage) ─────────

# If not set, the pipeline uses local JSON files in /data/
SUPABASE_URL=
SUPABASE_KEY=

# ─── Optional: Social Listening Config ────────────────────

# Comma-separated list of target areas to monitor
# e.g., "Miami,Fort Lauderdale,Boca Raton,Palm Beach"
TARGET_AREAS=

# Your primary market area (used in LLM analysis)
AGENT_AREA=

# ─── Optional: Webhook Security ──────────────────────────

# Secret for verifying FUB webhook signatures
FUB_WEBHOOK_SECRET=

# Secret for protecting cron endpoints
CRON_SECRET=

# ─── Optional: Rate Limiting ─────────────────────────────

# Delay between contacts in batch mode (ms)
BATCH_DELAY_MS=2000

# Max contacts per batch run
BATCH_LIMIT=20
